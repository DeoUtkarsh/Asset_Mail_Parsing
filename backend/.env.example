# ── Gmail / IMAP (broker mailbox) ────────────────────────────────
EMAIL_USER=your_mailbox@example.com
EMAIL_PASSWORD=your_app_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Automated/notification senders to skip (comma-separated substrings,
# matched case-insensitively against the whole "From" header).
# Do NOT block gmail.com — real brokers may use Gmail.
BLOCKED_SENDER_PATTERNS=google.com,accounts.google.com,no-reply,noreply,donotreply,mailer-daemon,postmaster

# ── Anthropic Claude (primary LLM: text + vision + PDF) ───────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5

# ── NVIDIA NIM (legacy — kept for reference, no longer used) ──────
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
# NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_PARSE_MODEL=nvidia/nemotron-parse

# ── PostgreSQL (local pgAdmin) ────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=email_parser_dev
PG_USER=postgres
PG_PASSWORD=your_postgres_password

# ── Processing limits ─────────────────────────────────────────────
# Max broker emails to process per fetch (0 = all). Only NEW emails
# (unseen Message-IDs) are ever processed.
MAX_ATTACHMENTS=0

# ── Attachment files (optional S3) ────────────────────────────────
# Leave ATTACHMENTS_S3_BUCKET empty for local attachment_files/ folder.
# On AWS set the bucket name; ECS task role must allow s3 Get/Put.
# ATTACHMENTS_S3_BUCKET=email-parser-attachments-867492128821
# ATTACHMENTS_S3_PREFIX=attachment_files
# AWS_REGION=ap-southeast-1
