# ── Gmail / IMAP ─────────────────────────────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
FILTER_SENDER=sender@example.com
TARGET_SUBJECT=Legacy optional subject filter (fetch rules live in backend/mail_targets.py)

# 0 = all .eml / rfc822 parts per fetch; use N>0 to cap during testing.
MAX_ATTACHMENTS=0

# LLM extraction rate-limit tuning (lower concurrency if you see HTTP 429)
EXTRACTION_CONCURRENCY=2
EXTRACTION_MAX_ATTEMPTS=6
EXTRACTION_RATE_LIMIT_BASE_SEC=8
EXTRACTION_REQUEST_DELAY_SEC=1

# ── NVIDIA NIM ────────────────────────────────────────────────────
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse

# ── PostgreSQL (local pgAdmin) ────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=email_parser
PG_USER=postgres
PG_PASSWORD=your_postgres_password
