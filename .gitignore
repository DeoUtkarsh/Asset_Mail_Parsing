# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.spec

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
.env_backup

# ── Secrets / Environment ─────────────────────────────────────────────────────
.env
*.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
# Keep the example file — it has no real secrets
!backend/.env.example

# Cloud / AWS credentials & keys
.aws/
*.pem
*.key
credentials.json

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/node_modules/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime artifacts (regenerated by the app) ────────────────────────────────
# Stored email file attachments (binary, regenerated on fetch)
backend/attachment_files/
# Debug / audit output
backend/output/

# ── OS / Editor / Assistant ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/
.claude/
.cursor/

# ── Logs / Misc ───────────────────────────────────────────────────────────────
*.log
logs/
*.bak
*.tmp
